# Copy this file to .env.mac-worker on the Mac mini. Never commit the copy.
DATABASE_URL=postgresql://USER:PASSWORD@RENDER_EXTERNAL_HOST:5432/DATABASE?sslmode=require
R2_ENDPOINT=https://6d95407ee5e890968497e5a42412af7b.r2.cloudflarestorage.com
R2_BUCKET=axios-clip-assets
R2_REGION=auto
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key

# Optional YouTube/worker settings.
SOURCE_PLATFORM_PROVIDERS=youtube
YOUTUBE_DATA_API_KEY=
CLIPPER_API_URL=https://your-render-api.onrender.com
YOUTUBE_CHANNEL_ID=
YOUTUBE_INGEST_LIMIT=5
YOUTUBE_INGEST_MODE=find_moments

# The insights service imports this file only when it exists and its contents
# have changed. Place the refreshed export on the Mac mini at the path mounted
# by docker-compose.mac-worker.yml.
YOUTUBE_RETENTION_IMPORT_ENABLED=true
YOUTUBE_RETENTION_FORCE=false
